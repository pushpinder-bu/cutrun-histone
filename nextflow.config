// ---------------------------------------------------------------
// nextflow.config - pipeline metadata, default parameters and profiles
// ---------------------------------------------------------------

manifest {
    name            = 'pushpinder-bu/cutrun-histone'
    author          = 'Pushpinder Bawa'
    homePage        = 'https://github.com/pushpinder-bu/cutrun-histone'
    description     = 'CUT&RUN histone-mark analysis: alignment, QC, coverage, peaks and cross-sample overlaps'
    mainScript      = 'main.nf'
    nextflowVersion = '>=24.04.0'
    version         = '1.0.0'
}

// Default parameters (override on the command line: --name value)
params {
    input                 = 'samplesheet.csv'
    outdir                = 'results'
    bowtie2_index         = '/restricted/projectnb/crem-bioinfo/reference_data/REFERENCES/GRCh38/bwa/withChr/bowtie/hg38'
    effective_genome_size = 2913022398
    bw_bin_size           = 10
    extend_reads          = 200

    // per-cell-type plots
    gene_annotation       = '/restricted/projectnb/crem-bioinfo/reference_data/REFERENCES/GRCh38/bwa/withChr/chr.gtf'   // GTF with transcript lines, or BED of transcripts (TSS = strand-aware start)
    control_mark          = 'IgG'          // value in the samplesheet 'mark' column used as control
    profile_windows       = '2000,5000'    // TSS +/- window sizes (bp) for profiles; the largest is used for the heatmap
    heatmap_cluster_mark  = 'H3K27me3'     // mark used to cluster the TSS heatmap
    heatmap_kmeans        = 3

    // peak calling (each mark against the IgG of the same cell type)
    broad_marks           = 'H3K27me3'     // comma-separated marks called in MACS2 broad mode; others narrow
    macs2_qvalue          = 0.01           // narrow peaks
    macs2_broad_cutoff    = 0.1            // broad peaks
    macs2_gsize           = null           // genome size for MACS2; default: effective_genome_size
    seacr_mode            = 'stringent'    // SEACR threshold: stringent or relaxed
    blacklist             = null           // BED of problem regions to remove from peaks (e.g. ENCODE hg38 blacklist)

    // overlaps across cell types
    promoter_flank        = 2500           // promoter = TSS +/- this many bp
    domain_merge_distance = 5000           // broad marks: join peaks closer than this into domains
    overlap_bin_size      = 5000           // broad marks: bin size for comparing domains

    // suffix for run-report file names (a fresh timestamp for every run)
    trace_report_suffix   = new java.util.Date().format('yyyy-MM-dd_HH-mm-ss')
}

// Resources per label (all profiles)
includeConfig 'conf/base.config'

// Ignore Python packages in the user's home (~/.local). Singularity mounts $HOME inside the container,
// so without this, packages in ~/.local could still leak into containerised Python tools (deepTools, MultiQC)
env {
    PYTHONNOUSERSITE = '1'
}

profiles {
    // ---- Small public test dataset (combine with a software profile: -profile test,docker) ----
    test  { includeConfig 'conf/test.config' }

    // ---- WHERE tasks run ----
    // BU SCC: every process becomes its own SGE job
    scc   { includeConfig 'conf/scc.config' }

    // The current machine (laptop, login node, CI runner)
    local {
        process.executor       = 'local'
        // never ask for more CPUs than this machine has
        process.resourceLimits = [ cpus: Runtime.runtime.availableProcessors() ]
    }

    // ---- HOW software is provided: every process runs in its own pinned container ----
    docker {
        docker.enabled     = true
        // run as the current user; images are built for x86-64 (emulated on Apple Silicon)
        docker.runOptions  = '-u $(id -u):$(id -g) --platform linux/amd64'
        singularity.enabled = false
    }
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        docker.enabled         = false
    }
}

// Run reports, written to <outdir>/pipeline_info
timeline { enabled = true; file = "${params.outdir}/pipeline_info/timeline_${params.trace_report_suffix}.html" }
report   { enabled = true; file = "${params.outdir}/pipeline_info/report_${params.trace_report_suffix}.html" }
trace    {
    enabled = true
    file    = "${params.outdir}/pipeline_info/trace_${params.trace_report_suffix}.txt"
    fields  = 'task_id,hash,native_id,name,status,exit,container,cpus,submit,duration,realtime,%cpu,peak_rss,rchar,wchar'
}
