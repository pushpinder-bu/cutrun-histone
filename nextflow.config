// ---------------------------------------------------------------
// manifest - pipeline name and version (printed in every run log)
// ---------------------------------------------------------------
manifest {
    name            = 'pushpinder-bu/cutrun-histone'
    author          = 'Pushpinder Bawa'
    homePage        = 'https://github.com/pushpinder-bu/cutrun-histone'
    description     = 'CUT&RUN histone-mark analysis: alignment, QC, coverage, peaks and cross-sample overlaps'
    mainScript      = 'main.nf'
    nextflowVersion = '>=23.04.0'
    version         = '0.1.0'
}

// ---------------------------------------------------------------
// nextflow.config - WHERE and HOW each process runs
// (replaces the #$ lines and "module load" lines of your qsub scripts)
// ---------------------------------------------------------------

profiles {

    // Run on the SCC: every task becomes its own qsub job
    scc {
        process {
            executor       = 'sge'
            penv           = 'omp'                                  // -> #$ -pe omp <cpus>
            clusterOptions = '-P crem-bioinfo -V -l mem_per_core=8G'
            beforeScript   = 'type module >/dev/null 2>&1 || source /etc/profile.d/lmod.sh 2>/dev/null || true'

            withLabel: 'big'   { cpus = 8; time = '24h' }           // -> -pe omp 8, -l h_rt=24:00:00
            withLabel: 'small' { cpus = 1; time = '4h'  }

            withName: 'ALIGN'      { module = 'bowtie2/2.5.1:samtools' }
            withName: 'FILTER_BAM' { module = 'samtools:sambamba' }
        }
        executor.queueSize = 50                                     // max jobs in the queue at once
    }

    // Quick local test of the wiring (use with -stub-run)
    test {
        process.executor = 'local'
        process.cpus     = 1
    }
}
