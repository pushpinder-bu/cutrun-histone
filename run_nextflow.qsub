#!/bin/bash -l
# Runs the Nextflow controller as a small SCC job; it submits every pipeline step as its own SGE job,
# each in its own Singularity container.
# Usage (from your project folder, next to samplesheet.csv):  qsub /path/to/cutrun-histone/run_nextflow.qsub
#$ -P crem-bioinfo
#$ -N nf_head
#$ -l h_rt=72:00:00
#$ -pe omp 1
#$ -j y
#$ -cwd

PIPELINE_DIR="${PIPELINE_DIR:-$HOME/cutrun-histone}"   # where you cloned this repository

# Singularity converts images in a temporary folder; keep it in project space (avoids /scratch 'nodev' issues)
export SINGULARITY_TMPDIR=/restricted/projectnb/crem-bioinfo/$USER/singularity_tmp
mkdir -p "$SINGULARITY_TMPDIR"

module load nextflow
nextflow run "$PIPELINE_DIR/main.nf" -profile scc,singularity \
    --input samplesheet.csv --outdir results -resume
