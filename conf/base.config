// ---------------------------------------------------------------
// conf/base.config - resources per label, used by every profile.
// Processes ask for a label; the numbers live only here.
// ---------------------------------------------------------------

process {
    cpus = 1
    time = '4h'

    // retry once if the scheduler killed the job (e.g. out of time or memory); otherwise
    // let running tasks finish and stop
    errorStrategy = { task.exitStatus in [137, 138, 139, 140, 143] ? 'retry' : 'finish' }
    maxRetries    = 1

    withLabel: 'process_low'    { cpus = 1; time = { 4.h  * task.attempt } }
    withLabel: 'process_medium' { cpus = 4; time = { 12.h * task.attempt } }
    withLabel: 'process_high'   { cpus = 8; time = { 24.h * task.attempt } }
}
