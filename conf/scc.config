// ---------------------------------------------------------------
// conf/scc.config - BU Shared Computing Cluster (SGE)
// Each process is submitted as its own SGE job.
// ---------------------------------------------------------------

process {
    executor       = 'sge'
    penv           = 'omp'                                    // -> #$ -pe omp <cpus>
    clusterOptions = '-P crem-bioinfo -V -l mem_per_core=8G'
    beforeScript   = 'type module >/dev/null 2>&1 || source /etc/profile.d/lmod.sh 2>/dev/null || true'

    // Tool versions from SCC environment modules (replaced by containers in a later release)
    // TODO: pin exact versions for samtools, sambamba, bedtools (module avail <tool>)
    withName: 'FASTQC'      { module = 'fastqc/0.12.1' }
    withName: 'ALIGN'       { module = 'bowtie2/2.5.1:samtools' }
    withName: 'FILTER_BAM'  { module = 'samtools:sambamba' }
    withName: 'BAMCOVERAGE' { module = 'R/4.1.2:gcc/8.3.0:hdf5/1.8.21:python3/3.8.6:deeptools/3.5.1' }
    withName: 'QC_STATS'    { module = 'samtools:bedtools:preseq/2.0' }
    withName: 'MULTIQC'     { module = 'multiqc/1.12' }
}

executor {
    queueSize      = 50          // max jobs in the SGE queue at once
    submitRateLimit = '10 sec'   // be gentle with the scheduler
}
