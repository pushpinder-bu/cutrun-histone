// ---------------------------------------------------------------
// conf/scc.config - BU Shared Computing Cluster (SGE)
// WHERE tasks run. Combine with a software profile: -profile scc,singularity
// ---------------------------------------------------------------

process {
    executor       = 'sge'
    penv           = 'omp'                                    // -> #$ -pe omp <cpus>
    clusterOptions = '-P crem-bioinfo -V -l mem_per_core=8G'
}

executor {
    queueSize       = 50          // max jobs in the SGE queue at once
    submitRateLimit = '10 sec'    // be gentle with the scheduler
}

// Keep container images in project space (home quota is small); downloaded once, reused by every run
singularity {
    cacheDir = "/restricted/projectnb/crem-bioinfo/${System.getProperty('user.name')}/singularity_cache"
}
