// ---------------------------------------------------------------
// conf/test.config - small public test dataset; runs in minutes on a laptop or CI runner
//   nextflow run . -profile test,docker
// Data: nf-core test-datasets (cutandrun branch), GEO GSE145187, 10,000 read pairs per sample,
//       H3K27me3 / H3K4me3 / IgG, two replicates (used here as two "cell types"), aligned to hg38 chr20.
// ---------------------------------------------------------------

params {
    input                 = "${projectDir}/assets/samplesheet_test.csv"
    outdir                = 'results_test'
    bowtie2_index         = 'https://raw.githubusercontent.com/nf-core/test-datasets/cutandrun/reference/genomes/hg38-chr20-bowtie2.tar.gz'
    effective_genome_size = 64444167                       // length of hg38 chr20
}

process {
    executor       = 'local'
    // stay within a standard GitHub Actions runner (4 CPUs, 16 GB) and within smaller machines (laptops, Docker VMs)
    resourceLimits = [ cpus: Math.min(4, Runtime.runtime.availableProcessors()), memory: '12.GB', time: '1.h' ]
}
